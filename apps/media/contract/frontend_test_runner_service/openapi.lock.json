{
  "components": {
    "parameters": {
      "TenantIdHeader": {
        "description": "License token transport: `Bearer <token>`.",
        "in": "header",
        "name": "X-Tenant-Id",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "AsyncJobResponse": {
        "description": "Returned immediately when a job is created.",
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "poll_url": {
            "title": "Poll Url",
            "type": "string"
          },
          "status": {
            "default": "pending",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "poll_url"
        ],
        "title": "AsyncJobResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobStatusResponse": {
        "description": "Response for job status polling.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "progress": {
            "default": 0.0,
            "title": "Progress",
            "type": "number"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobStatusResponse",
        "type": "object"
      },
      "ScenarioClip": {
        "additionalProperties": true,
        "description": "A per-scenario recorded video clip harvested from a Playwright run.\n\n``clip_key`` is the pipeline-wide join spine (the ``clip-<n>`` tag stamped by\nbdd_playwright_service) binding this clip to its narration part and compile\nshot. ``video_url`` is the tenant-scoped stream-through route on this service.",
        "properties": {
          "clip_key": {
            "default": "",
            "title": "Clip Key",
            "type": "string"
          },
          "cursor_track": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor Track"
          },
          "duration_ms": {
            "default": 0.0,
            "title": "Duration Ms",
            "type": "number"
          },
          "feature": {
            "default": "",
            "title": "Feature",
            "type": "string"
          },
          "focus_track": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focus Track"
          },
          "has_audio": {
            "default": false,
            "title": "Has Audio",
            "type": "boolean"
          },
          "height": {
            "default": 0,
            "title": "Height",
            "type": "integer"
          },
          "scenario": {
            "default": "",
            "title": "Scenario",
            "type": "string"
          },
          "size_bytes": {
            "default": 0,
            "title": "Size Bytes",
            "type": "integer"
          },
          "status": {
            "default": "",
            "title": "Status",
            "type": "string"
          },
          "video_url": {
            "default": "",
            "title": "Video Url",
            "type": "string"
          },
          "viewport": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Viewport"
          },
          "width": {
            "default": 0,
            "title": "Width",
            "type": "integer"
          }
        },
        "title": "ScenarioClip",
        "type": "object"
      },
      "TestCaseResult": {
        "additionalProperties": true,
        "description": "Individual test case outcome.",
        "properties": {
          "duration_ms": {
            "default": 0.0,
            "title": "Duration Ms",
            "type": "number"
          },
          "error": {
            "default": "",
            "title": "Error",
            "type": "string"
          },
          "feature": {
            "default": "",
            "title": "Feature",
            "type": "string"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "screenshot_url": {
            "default": "",
            "title": "Screenshot Url",
            "type": "string"
          },
          "status": {
            "default": "",
            "title": "Status",
            "type": "string"
          },
          "trace_url": {
            "default": "",
            "title": "Trace Url",
            "type": "string"
          }
        },
        "title": "TestCaseResult",
        "type": "object"
      },
      "TestExecutionRequest": {
        "additionalProperties": false,
        "description": "Request to execute a test suite against a target URL.",
        "properties": {
          "auth_config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Auth credentials + SSO hints forwarded to auth.setup.ts: {type, login_url, username, password, sso_button, success_url}. sso_button is the IdP button label to click when the login form is not inline (e.g. Keycloak); success_url is the post-login URL to wait for. Both optional. A LIST is one login per origin (each entry carries `origin` or a `login_url` it is derived from) for a recording that signs into several apps; the package reads them from the JSON file named by AUTH_LOGINS_FILE, keyed by origin (or origin#label when several share it).",
            "title": "Auth Config"
          },
          "bdd_job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "BDD Playwright Service job ID to fetch package from",
            "title": "Bdd Job Id"
          },
          "browsers": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "title": "Browsers",
            "type": "array"
          },
          "expect_recording": {
            "default": true,
            "description": "Whether this package is expected to produce one video clip per scenario. When true (the default) a run that persists ZERO usable clips is FAILED rather than reported as a successful empty run — the orchestrator's demo_video_record stage would otherwise compile and bill for a footage-free video. Set false ONLY for a package that deliberately does not record (Playwright `use.video: 'off'`, or 'retain-on-failure' where all tests pass): there, N passing specs and zero clips is a healthy result and the zero-footage gate would be a false positive that the Idempotency-Key semantics make permanent for that key.",
            "title": "Expect Recording",
            "type": "boolean"
          },
          "grep_pattern": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Filter which tests to run",
            "title": "Grep Pattern"
          },
          "max_run_seconds": {
            "anyOf": [
              {
                "maximum": 1800.0,
                "minimum": 10.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional wall-clock override for this run. Defaults to the service ceiling (EXECUTION_MAX_RUN_SECONDS). Pair with a single-`@clip` grep_pattern for a short-budget per-clip dry-run instead of a full harvest. Bounded under the orchestrator's ~1800s re-poll total so a record stage keeps polling the idempotent job.",
            "title": "Max Run Seconds"
          },
          "package_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URL to download test ZIP package",
            "title": "Package Url"
          },
          "retries": {
            "default": 0,
            "description": "Number of retries per failing test (0 - 10)",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Retries",
            "type": "integer"
          },
          "screenshot_on_failure": {
            "default": true,
            "description": "NOT IMPLEMENTED — accepted for backwards compatibility and IGNORED. `playwright test` exposes no `--screenshot` flag, and the config carrying `use.screenshot` is generated by bdd_playwright_service, not by this service, so there is no lever here to honour it. Setting it to false adds an explicit notice to the job's `capture_warnings` rather than silently doing nothing; change the generator if you need failure screenshots off.",
            "title": "Screenshot On Failure",
            "type": "boolean"
          },
          "target_url": {
            "description": "Live site URL to test against",
            "title": "Target Url",
            "type": "string"
          },
          "timeout_per_test_ms": {
            "default": 30000,
            "description": "Per-test timeout in ms (1s - 10min)",
            "maximum": 600000.0,
            "minimum": 1000.0,
            "title": "Timeout Per Test Ms",
            "type": "integer"
          },
          "trace_on_failure": {
            "default": true,
            "description": "Record a Playwright trace on the first retry of a failing test. Wired through `playwright test --trace on-first-retry|off`, which overrides the generated config's hardcoded `on-first-retry`. Set false to keep trace zips (which the HTML report embeds and this service uploads to the shared object store) out of the artifacts.",
            "title": "Trace On Failure",
            "type": "boolean"
          },
          "workers": {
            "default": 1,
            "description": "Parallel Playwright worker processes (1 - 16)",
            "maximum": 16.0,
            "minimum": 1.0,
            "title": "Workers",
            "type": "integer"
          }
        },
        "required": [
          "target_url"
        ],
        "title": "TestExecutionRequest",
        "type": "object"
      },
      "TestExecutionResult": {
        "description": "Full result of a test execution job.",
        "properties": {
          "capture_warnings": {
            "items": {
              "type": "string"
            },
            "title": "Capture Warnings",
            "type": "array"
          },
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "execution_time_seconds": {
            "default": 0.0,
            "title": "Execution Time Seconds",
            "type": "number"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "report_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Url"
          },
          "scenario_clips": {
            "items": {
              "$ref": "#/components/schemas/ScenarioClip"
            },
            "title": "Scenario Clips",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/TestSummary"
          },
          "target_url": {
            "default": "",
            "title": "Target Url",
            "type": "string"
          },
          "test_results": {
            "items": {
              "$ref": "#/components/schemas/TestCaseResult"
            },
            "title": "Test Results",
            "type": "array"
          },
          "trace_urls": {
            "items": {
              "type": "string"
            },
            "title": "Trace Urls",
            "type": "array"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "TestExecutionResult",
        "type": "object"
      },
      "TestSummary": {
        "additionalProperties": false,
        "description": "Aggregate pass/fail counts.",
        "properties": {
          "failed": {
            "default": 0,
            "title": "Failed",
            "type": "integer"
          },
          "flaky": {
            "default": 0,
            "title": "Flaky",
            "type": "integer"
          },
          "pass_rate": {
            "default": 0.0,
            "title": "Pass Rate",
            "type": "number"
          },
          "passed": {
            "default": 0,
            "title": "Passed",
            "type": "integer"
          },
          "skipped": {
            "default": 0,
            "title": "Skipped",
            "type": "integer"
          },
          "total": {
            "default": 0,
            "title": "Total",
            "type": "integer"
          }
        },
        "title": "TestSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "License",
        "description": "License token. Transport: `X-Tenant-Id: Bearer <token>` (not the Authorization header — that is reserved for caller-side auth).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Playwright test execution microservice — runs BDD-generated tests against live sites",
    "title": "Frontend Test Runner Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Return service metadata and available endpoints.",
        "operationId": "service_root",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Service Root",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service banner + endpoint index",
        "tags": [
          "health"
        ]
      }
    },
    "/api/test-runner/execute": {
      "post": {
        "description": "Submit a test execution job. Returns immediately with a job_id for polling.",
        "operationId": "execute_test_run",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestExecutionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncJobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Start Execution",
        "tags": [
          "test-runner"
        ]
      }
    },
    "/api/test-runner/{job_id}": {
      "get": {
        "description": "Poll job status.",
        "operationId": "get_test_job_status",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Job Status",
        "tags": [
          "test-runner"
        ]
      }
    },
    "/api/test-runner/{job_id}/artifacts/{artifact_path}": {
      "get": {
        "description": "Serve a persisted report artifact for a completed job FROM THE SHARED STORE.\n\nReads object key ``{job_id}/{artifact_path}`` (e.g.\n``playwright-report/index.html``) so any replica serves any job's report.\nPath traversal in ``artifact_path`` is rejected by ``_safe_key`` (400).",
        "operationId": "get_test_job_artifact",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "artifact_path",
            "required": true,
            "schema": {
              "title": "Artifact Path",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Artifact",
        "tags": [
          "test-runner"
        ]
      }
    },
    "/api/test-runner/{job_id}/clips/{clip_key}/video": {
      "get": {
        "description": "Stream a per-scenario video clip for a completed job FROM THE SHARED STORE.\n\nTenant-scoped (cross-tenant → 404, no enumeration side channel). The clip\nfilename is resolved from the job's ``artifact_paths['clip_files']`` map and\nread by object key ``{job_id}/clips/<filename>`` — so any replica serves any\njob's clip (multi-replica safety), and the caller-supplied ``clip_key`` never\ntouches a filesystem path directly (traversal is rejected by ``_safe_key``).",
        "operationId": "get_test_job_clip_video",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "clip_key",
            "required": true,
            "schema": {
              "title": "Clip Key",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Clip Video",
        "tags": [
          "test-runner"
        ]
      }
    },
    "/api/test-runner/{job_id}/report": {
      "get": {
        "description": "Get HTML report URL for a completed job.",
        "operationId": "get_test_job_report",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Test Job Report",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Report",
        "tags": [
          "test-runner"
        ]
      }
    },
    "/api/test-runner/{job_id}/result": {
      "get": {
        "description": "Get full test execution result.",
        "operationId": "get_test_job_result",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestExecutionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Job Result",
        "tags": [
          "test-runner"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness probe.",
        "operationId": "health_check",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Check",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Liveness probe.",
        "operationId": "health_live",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Live",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
