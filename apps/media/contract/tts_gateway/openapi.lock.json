    "/api/tts/jobs/{job_id}/fail": {
      "post": {
        "description": "Report a synth failure.\n\n``worker_id`` is OPTIONAL only for rollout compatibility with the manually-deployed\nMac kokoro workers (see job_manager). When present, the failure is guarded on\n``claimed_by``, so a stale worker's late error cannot requeue — or, at the cap,\nPOISON — the claim another worker is actively working. A guarded miss returns\n``{\"status\": \"unknown\"}``: same shape, same 200, no retry bait.\n\n``terminal=true`` fails the job outright instead of requeueing it — for a failure\nno retry can fix (a 402 customer-config refusal from the synth target). It\nREQUIRES ``worker_id``: an unguarded terminal fail would let any holder of the\nshared legacy subject kill any claimed job outright.",
        "operationId": "tts.fail",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/fail"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Tts.Fail",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Report Failure",
        "tags": [
          "workers"
        ]
      }
    },
