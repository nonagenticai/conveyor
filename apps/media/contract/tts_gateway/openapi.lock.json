{
  "components": {
    "parameters": {
      "TenantIdHeader": {
        "description": "License token transport: `Bearer <token>`.",
        "in": "header",
        "name": "X-Tenant-Id",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "BatchStatusResponse": {
        "properties": {
          "batch_id": {
            "title": "Batch Id",
            "type": "string"
          },
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobStatus"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "batch_id",
          "jobs"
        ],
        "title": "BatchStatusResponse",
        "type": "object"
      },
      "ChunkIn": {
        "properties": {
          "ref": {
            "description": "Caller's opaque id (e.g. orchestrator chunk id)",
            "title": "Ref",
            "type": "string"
          },
          "speed": {
            "default": 1.0,
            "maximum": 2.0,
            "minimum": 0.5,
            "title": "Speed",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "voice": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          }
        },
        "required": [
          "ref",
          "text"
        ],
        "title": "ChunkIn",
        "type": "object"
      },
      "ClaimRequest": {
        "properties": {
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id"
        ],
        "title": "ClaimRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobRef": {
        "properties": {
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "job_id",
          "idempotency_key",
          "status"
        ],
        "title": "JobRef",
        "type": "object"
      },
      "JobStatus": {
        "description": "One job as the orchestrator reads it while polling a batch.\n\n``duration_seconds`` is ``None`` in TWO different situations, and a consumer that\ncannot tell them apart mis-builds the narration timeline:\n\n* the job has not finished yet — there is no duration to have;\n* the job IS ``done`` and its clip is real, but the synth backend never measured\n  a length (``tts_backend`` emits ``duration_sec = frames / sr if sr else 0.0``).\n\n``duration_unmeasured`` names the second case. It exists because the second case\nused to be published as the number ``0.0``, which is indistinguishable from a\ngenuine measurement: the timeline allocated no time at all for a chunk full of\nspeech, narration drifted against picture for everything after it, and the batch\nand the run both reported success. A consumer must treat ``duration_unmeasured``\nas \"audio of unknown length\" — measure the clip, or degrade loudly — and never as\n\"zero seconds of audio\".",
        "properties": {
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "duration_unmeasured": {
            "default": false,
            "title": "Duration Unmeasured",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "result_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Url"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "idempotency_key",
          "status"
        ],
        "title": "JobStatus",
        "type": "object"
      },
      "SubmitBatchRequest": {
        "properties": {
          "batch_id": {
            "description": "One book's narrate submission id",
            "maxLength": 64,
            "title": "Batch Id",
            "type": "string"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/ChunkIn"
            },
            "title": "Chunks",
            "type": "array"
          }
        },
        "required": [
          "batch_id",
          "chunks"
        ],
        "title": "SubmitBatchRequest",
        "type": "object"
      },
      "SubmitBatchResponse": {
        "properties": {
          "batch_id": {
            "title": "Batch Id",
            "type": "string"
          },
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobRef"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "batch_id",
          "jobs"
        ],
        "title": "SubmitBatchResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "fail": {
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "terminal": {
            "default": false,
            "title": "Terminal",
            "type": "boolean"
          },
          "worker_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Id"
          }
        },
        "required": [
          "error"
        ],
        "title": "Body_tts.fail",
        "type": "object"
      },
      "heartbeat": {
        "properties": {
          "worker_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Id"
          }
        },
        "title": "Body_tts.heartbeat",
        "type": "object"
      },
      "release": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id"
        ],
        "title": "Body_tts.release",
        "type": "object"
      },
      "result": {
        "properties": {
          "audio": {
            "contentMediaType": "application/octet-stream",
            "title": "Audio",
            "type": "string"
          },
          "duration_seconds": {
