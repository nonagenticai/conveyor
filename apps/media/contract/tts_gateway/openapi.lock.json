  "info": {
    "description": "w2v service — w2v service",
    "title": "tts-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/tts/batches": {
      "post": {
        "description": "Enqueue a book idempotently, confirming every dedupe HIT still has its clip.\n\nSubmit deduplicates on ``sha256(tenant|voice|speed|preproc|text)`` and that key\nIS the object name, so a ``done`` row can outlive its audio (lifecycle expiry, a\nbucket sweep, a half-failed upload). Returning ``done`` for such a row is a dead\nreference: the poll presigns a URL for nothing and the downstream compile 404s,\nfailing the whole run. So every hit that comes back ``done`` is confirmed\nagainst storage first, and a definitively-absent clip is re-queued rather than\npublished. See ``jm.requeue_jobs_with_missing_clips`` for cost + race handling.",
        "operationId": "tts.batches.submit",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantIdHeader"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitBatchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Submit Batch",
        "tags": [
          "batches"
        ]
      }
    },
