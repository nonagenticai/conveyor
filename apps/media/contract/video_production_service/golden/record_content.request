{"html_content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Capture sample page</title>\n<style>\n  html, body { margin: 0; font-family: sans-serif; background: #f7f7f2; color: #1b1b1b; }\n  header { padding: 24px 32px; background: #24506b; color: #fff; }\n  main { padding: 32px; }\n  .card { margin: 16px 0; padding: 24px; background: #fff; border: 1px solid #d8d8d8; border-radius: 8px; }\n  .swatch { display: inline-block; width: 48px; height: 48px; margin-right: 8px; border-radius: 6px; }\n</style>\n</head>\n<body>\n<header><h1>Contract capture sample</h1><p>One local page, no external resources.</p></header>\n<main>\n  <div class=\"card\"><h2>Section one</h2><p>Synthetic content for a deterministic screen recording.</p></div>\n  <div class=\"card\"><h2>Section two</h2>\n    <span class=\"swatch\" style=\"background:#24506b\"></span>\n    <span class=\"swatch\" style=\"background:#4fd1c5\"></span>\n    <span class=\"swatch\" style=\"background:#e0a800\"></span>\n  </div>\n  <div class=\"card\"><h2>Section three</h2><p>End of the one-page fixture.</p></div>\n</main>\n</body>\n</html>\n","part_id":"page001","recording_config":{"viewport_width":320,"viewport_height":240,"output_format":"mp4","timeout_ms":60000},"scroll_config":{"enabled":true,"speed_px_per_second":5000,"start_delay_seconds":0,"end_delay_seconds":0}}