POST /api/record/animation
{"X-Tenant-Id":"00000000-0000-0000-0000-0000000000c1"}
{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Capture motion template</title>\n<style>\n  html, body { margin: 0; height: 100%; background: #101c2c; }\n  #stage { position: relative; width: 100%; height: 100%; overflow: hidden; }\n  #bar { position: absolute; top: 45%; left: 0; height: 10%; width: 12%; background: #4fd1c5; }\n</style>\n</head>\n<body>\n<div id=\"stage\"><div id=\"bar\"></div></div>\n<script>\n  window.RENDER_DURATION_MS = 1000;\n  window.render = function (t) {\n    var p = Math.max(0, Math.min(1, t / window.RENDER_DURATION_MS));\n    document.getElementById('bar').style.left = (p * 88) + '%';\n    document.body.style.background = p > 0.5 ? '#132a3c' : '#101c2c';\n  };\n</script>\n</body>\n</html>\n","part_id":"anim001","fps":10,"width":320,"height":240,"duration_ms":1000}