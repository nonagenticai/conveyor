# conveyor server image (template-rust-service shape, pinned at 0c7396a).
#
# Base images come from Docker Hub, pinned by digest: this repository is public, so a builder
# outside the estate must be able to pull them, and the digest keeps every build on the exact
# bytes CI produced. An estate build may override the base with `--build-arg BASE_IMAGE=<mirror
# path>` without editing this file; the default must work with nothing but Docker Hub access.
#
# The base is debian-slim rather than a Rust image (there is no glibc Rust image that fits),
# so the pinned toolchain is installed by rustup; builder, web and runtime share one glibc.
# RUST_TOOLCHAIN must equal rust-toolchain.toml.
ARG RUST_TOOLCHAIN=1.99.0
ARG BASE_IMAGE=docker.io/library/debian:12-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

FROM ${BASE_IMAGE} AS build
ARG RUST_TOOLCHAIN
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# cmake/perl: aws-lc-sys (rustls' default crypto provider, via sqlx and reqwest).
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl perl pkg-config \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && rustc --version

WORKDIR /src
COPY . .
# `-p conveyor-server` (not a bare workspace build): a broken sibling crate must not block
# the service image, and the binary needs no other member's artifacts beyond its deps.
# sqlx::migrate! embeds migrations/ into the binary, so the runtime image needs no SQL files.
# ⛔ Every cache mount below carries an EXPLICIT `id=`, and the two stages' ids are disjoint.
# BuildKit builds independent stages IN PARALLEL, and a cache mount's default id is its target
# path — so without distinct ids the `build` and `web` stages compiled into one registry/src and
# one /src/target at the same time. A warm ARC builder hid this; the first cold GitHub-hosted
# build failed deterministically: `failed to open …/tracing-subscriber-0.3.23/.cargo-ok:
# File exists (os error 17)` in the web stage while the build stage unpacked the same crate.
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-build \
    --mount=type=cache,target=/src/target,id=cargo-target-build \
    cargo build --release --locked -p conveyor-server \
    && install -D -m 0755 target/release/conveyor /out/conveyor

# ── the static UI (approved 2026-11-09: one image, one host, the server serves it) ────────
# cargo-leptos installs into its OWN root: a cache mount over /usr/local/cargo/bin would
# shadow the rustup cargo shim the base stage just installed.
FROM ${BASE_IMAGE} AS web
ARG RUST_TOOLCHAIN
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl pkg-config \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/opt/cargo-leptos/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && rustup target add wasm32-unknown-unknown

WORKDIR /src
COPY . .
# ⛔ The install and the build are ONE step on purpose. A `--mount=type=cache` survives
# within a single RUN and is discarded after it, so installing into a cache-mounted root in
# its own step left `cargo leptos` unavailable in the next one ("no such command: leptos",
# measured on PR #9's first build). Both caches are still declared here, which is what keeps
# the install warm across builds.
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-web \
    --mount=type=cache,target=/opt/cargo-leptos,id=cargo-leptos-web \
    --mount=type=cache,target=/src/target,id=cargo-target-web \
    cargo install cargo-leptos --version 0.3.11 --locked --root /opt/cargo-leptos \
    && cargo leptos build --release --frontend-only --cargo-locked \
    && mkdir -p /out/site \
    && cp -a target/site/. /out/site/ \
    # /config.json is generated by the server from the live configuration; a copied file could
    # only go stale (the development one says dev_auth: true).
    && rm -f /out/site/config.json \
    && cp apps/web/index.html apps/web/style.css /out/site/ \
    # The SPEC_V2 studio design pack, published read-only at /design. Only the runtime files
    # ship; scripts and Markdown stay in the repository. `index.html` is a build-time copy of
    # studio.html so the static handler's directory index resolves /design/.
    && mkdir -p /out/site/design/assets /out/site/design/architecture/diagrams \
    && cp docs/design/*.html docs/design/*.css docs/design/*.js /out/site/design/ \
    && cp -a docs/design/assets/. /out/site/design/assets/ \
    && cp docs/design/architecture/diagrams/*.svg /out/site/design/architecture/diagrams/ \
    && cp docs/design/studio.html /out/site/design/index.html

FROM ${BASE_IMAGE} AS runtime
# ca-certificates: outbound https (rustls platform roots, OIDC JWKS). curl: the HEALTHCHECK.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 app \
    && useradd --system --uid 65532 --gid 65532 --home-dir /var/lib/app --create-home app
COPY --from=build /out/conveyor /usr/local/bin/conveyor
# The same-origin UI. The server serves it when /srv/site exists; no deployment change is
# needed beyond this copy (CONVEYOR_WEB_ROOT overrides the path for a local run).
COPY --from=web /out/site /srv/site
# The contract port is the image default so the HEALTHCHECK below has a real port even when
# BIND_ADDR is not supplied (`docker run conveyor-app` serves on 8930 and passes its own
# probe). An explicit BIND_ADDR still moves the probe with it; the DATABASE_* URLs are
# supplied at runtime (gitops onboarding in S14; compose.yaml locally).
ENV RUST_LOG=info \
    BIND_ADDR=0.0.0.0:8930
WORKDIR /var/lib/app
USER 65532:65532
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["sh", "-c", "curl -fsS -o /dev/null \"http://127.0.0.1:${BIND_ADDR##*:}/health\""]
ENTRYPOINT ["/usr/local/bin/conveyor"]
