    "clusterBkg": "#16201b",
    "clusterBorder": "#3a4a40",
    "titleColor": "#e8eee9",
    "edgeLabelBackground": "#1b2620",
    "actorBkg": "#1e2a24",
    "actorBorder": "#6f8a7a",
    "actorTextColor": "#e8eee9",
    "signalColor": "#8aa596",
    "signalTextColor": "#e8eee9",
    "labelBoxBkgColor": "#1b2620",
    "labelBoxBorderColor": "#3a4a40",
    "noteBkgColor": "#2c281f",
    "noteBorderColor": "#9a875c",
