  classDef v1 fill:#eef3ef,stroke:#8aa596,color:#1f2a24
  classDef v2 fill:#ffffff,stroke:#8aa596,stroke-dasharray:5 3,color:#1f2a24
  classDef bad fill:#fdf1ee,stroke:#c98b7b,color:#1f2a24
